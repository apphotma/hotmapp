{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "hotma-app",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|html|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/create-subscription",
        "function": "createSubscription"
      },
      {
        "source": "/api/payment-webhook",
        "function": "paymentWebhook"
      },
      {
        "source": "/api/ackDelivery",
        "function": "ackDelivery"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-project-debug.log"
      ]
    }
  ]
}
